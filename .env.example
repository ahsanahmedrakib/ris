APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Bangladesh Standard Time. APP_TIMEZONE drives the PHP date functions and
# DB_TIMEZONE pins the MySQL session zone, which is what TIMESTAMP columns are
# converted on read and write. The two must describe the same offset, or every
# stored instant lands the wrong number of hours away from the time it records.
APP_TIMEZONE=Asia/Dhaka
DB_TIMEZONE=+06:00

# Uploaded files are written straight into the web root, so an admin upload is
# served immediately: public/images/<folder>/<name> is reachable at /images/... and
# public/files/<folder>/<name> at /files/.... See the 'public' and 'public_files'
# disks in config/filesystems.php.
#
# On cPanel these are ordinary directories next to the code, which means they are
# NOT in version control (only their .htaccess guards are) and must be backed up
# and carried across a release separately. Recreate the folders and their guards
# on the server if a release drops them, and never clear their contents.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Keep this true anywhere real. It encrypts the session payload, so a stolen
# cookie cannot be read or replayed against the database.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverse proxy / load balancer. Set these whenever the app does not talk to
# the browser directly. Without TRUSTED_PROXIES, X-Forwarded-Proto is ignored,
# so Laravel thinks every request is plain HTTP: secure cookies and HSTS stop
# being sent, and every rate limit is keyed off the proxy's single IP. Comma
# separated, or * only if nothing else can reach the app.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2
# Comma separated hostnames. This is what stops Host header spoofing, so set it
# to the real public domain(s) rather than leaving it open.
# TRUSTED_HOSTS=example.com,www.example.com

# HSTS is sent only over HTTPS and includes includeSubDomains, so leave it off
# until every subdomain is genuinely served over TLS. It is hard to undo.
# SECURITY_HSTS=false
# SECURITY_HSTS_MAX_AGE=31536000

# Narrow additions to the Content-Security-Policy, one source list per
# directive. Only needed if a third party actually serves something.
# CSP_SCRIPT_SRC=
# CSP_STYLE_SRC=
# CSP_IMG_SRC=
# CSP_FONT_SRC=
# CSP_CONNECT_SRC=
# CSP_FRAME_SRC=

VITE_APP_NAME="${APP_NAME}"

# Initial administrator, created by `php artisan app:provision-admin`. This is
# no longer done automatically during seeding, so run the command yourself on a
# fresh install. It refuses a password under 12 characters or without letters,
# numbers and symbols, so the placeholder below is rejected on purpose:
# set a real one, or leave it empty and answer the interactive prompt.
DEFAULT_ADMIN_NAME="Admin"
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=ris@1234
DEFAULT_ADMIN_PASSWORD=
