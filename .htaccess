# The document root must be set to public/ in cPanel (Domains -> domain ->
# Document Root), because Vite emits absolute asset URLs such as /build/... and
# /images/... that only resolve when public/ is the web root. Setting it to the
# repository root serves no static files at all.
#
# This file exists for the layout where the repository *is* the document root: it
# routes requests into public/index.php, and, more importantly, it refuses to
# hand out the application internals that sit next to public/. Without these rules
# a misconfigured domain would serve .env, the cached config, every log line and
# the whole vendor tree.
#
# Do not add allowances for static files here. If you find yourself needing one,
# the document root is wrong; fix that instead.

<IfModule mod_dir.c>
    FallbackResource /public/index.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Application source and state. public/ is the only directory meant to be
    # reachable, and it is reached through the fallback above.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(?:/|$) - [F,L]

    # Server-side sources and secrets sitting next to public/.
    RewriteRule "(?i)(^|/)\." - [F,L]
    RewriteRule "(?i)^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml.*|vite\.config\..*|server\.php|.*\.(?:md|sqlite|sql|log|ini|bak))$" - [F,L]

    # Never execute a script that reached the repository root.
    RewriteRule "(?i)\.(php|phps|php[0-9]|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh|bash|exe|com|bat|cmd)$" - [F,L]

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
</IfModule>

# Fallback for hosts without mod_rewrite.
<FilesMatch "(?i)^\.|\.(env|ini|log|sql|sqlite|bak|old|orig|save|swp|dist|sample)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
